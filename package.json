{
  "name": "ida-os-github",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.5",
    "typescript": "~7.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "lucide-react": "^0.577.0",
    "@supabase/supabase-js": "^2.117.3",
    "docx": "^9.5.1",
    "xlsx": "^0.18.5",
    "pptxgenjs": "^3.12.0",
    "react-markdown": "^10.1.0",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "katex": "^0.16.22"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "concurrently": "^9.2.0",
    "wait-on": "^8.0.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mextur.idaos",
    "productName": "IDA OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "version": "1.0.0",
  "description": "IDA OS — browser-based workspace and creator tools",
  "author": "Mextur Softwares"
}
